Bootstrap: docker
From: debian:12

%files
server.properties /server.properties
start-kafka.sh /start-kafka.sh

%arguments
kafka_version=2.13

%environment
export LC_ALL=C
export BROKER_PORT=${BROKER_PORT:-9092}
export CONTROLLER_PORT=${CONTROLLER_PORT:-9093}
# KAFKA_STORAGE_DIR is deliberately *not* defaulted here: its default depends on
# BROKER_PORT, and --env values are applied after this file is sourced, so a port
# override would not be visible yet. start-kafka.sh fills it in instead.
# Delete stream data this long after it was produced (ms). The file-writer consumes
# within seconds; this is slack, not durability.
export KAFKA_RETENTION_MS=${KAFKA_RETENTION_MS:-300000}
# Hard per-partition ceiling (bytes) for when a producer outruns the file-writer.
export KAFKA_RETENTION_BYTES=${KAFKA_RETENTION_BYTES:-268435456}
# How often the active segment is closed (ms). Retention cannot touch an open segment.
export KAFKA_SEGMENT_MS=${KAFKA_SEGMENT_MS:-30000}

%post
apt -y update && apt -y install wget gpg default-jre
mkdir -p /etc/apt/keyrings
wget -qO - https://packages.confluent.io/deb/7.9/archive.key | gpg --dearmor | tee /etc/apt/keyrings/confluent.gpg > /dev/null

CP_DIST=bookworm
echo "Types: deb
URIs: https://packages.confluent.io/deb/7.9
Suites: stable
Components: main
Architectures: $(dpkg --print-architecture)
Signed-by: /etc/apt/keyrings/confluent.gpg

Types: deb
URIs: https://packages.confluent.io/clients/deb/
Suites: ${CP_DIST}
Components: main
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/confluent.gpg" | tee /etc/apt/sources.list.d/confluent-platform.sources > /dev/null

apt-get -y update && apt-get -y install confluent-community-2.13
apt -y remove wget gpg && apt -y autoremove
apt clean

chmod +x /start-kafka.sh

echo "export CLUSTER_ID=\"$(kafka-storage random-uuid)\"" >> $APPTAINER_ENVIRONMENT

%labels
Version 3.1

%runscript
exec /start-kafka.sh

%startscript
exec /start-kafka.sh
